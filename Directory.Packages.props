    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.3" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.3.1" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.0" />
